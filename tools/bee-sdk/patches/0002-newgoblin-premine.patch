@@ -0,0 +1,151 @@
+//! NewGoblin patch 0002 (premine), design
+//! `docs/superpowers/specs/2026-10-31-pipelined-sessions-design.md` §1.
+//!
+//! While one session (A, in flight) is being delivered, a premine worker (B) mines the session
+//! after it and holds it until JS releases or discards it. Only one session can be mined ahead:
+//! the seed after `_seedNext` is drawn by the contract when `_seed` rotates.
+
+use crate::wasm::worker::MinerStatus;
+use crate::wasm::worker::SessionState;
+
+/// Which seed of the contract a premine session is mined on.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) enum PremineBasis {
+    /// `_seedNext`: the in-flight session has not ended on chain yet.
+    Next,
+    /// `_seed`: the in-flight session already ended on chain (accepted or cancelled).
+    Current,
+}
+
+impl PremineBasis {
+    pub fn name(&self) -> &'static str {
+        match self {
+            PremineBasis::Next => "next",
+            PremineBasis::Current => "current",
+        }
+    }
+}
+
+/// Seed and complexity a premine session is mined with.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) struct PremineTarget {
+    pub seed: String,
+    pub easy: u32,
+    pub hard: u32,
+    pub basis: PremineBasis,
+}
+
+/// Seed and complexity for a session mined while the one on `in_flight_seed` is delivered,
+/// without cancelling anything. `_seed = _seedNext` both when a session is accepted (`Old` takes
+/// `_*Complexity`) and on `cancelCommitData` (`Old` unchanged), see `session_complexity.rs`.
+/// - `_seed` is still the in-flight seed: mine `_seedNext`. Valid for both outcomes only while
+///   `_*Complexity == _*ComplexityOld`; otherwise `Err("complexity_unstable: ...")`.
+/// - `_seed` already rotated (the in-flight session ended on chain): mine `_seed` with `Old`, as
+///   a sequential session would.
+pub(crate) fn resolve_premine(
+    state: &SessionState,
+    in_flight_seed: &str,
+) -> Result<PremineTarget, String> {
+    let current = (state.easy_complexity, state.hard_complexity);
+    let old = (state.easy_complexity_old, state.hard_complexity_old);
+    if state.seed != in_flight_seed {
+        let (easy, hard) = old;
+        return Ok(PremineTarget {
+            seed: state.seed.clone(),
+            easy,
+            hard,
+            basis: PremineBasis::Current,
+        });
+    }
+    if current != old {
+        return Err(format!("complexity_unstable: current {current:?} != old {old:?}"));
+    }
+    let (easy, hard) = current;
+    Ok(PremineTarget { seed: state.seed_next.clone(), easy, hard, basis: PremineBasis::Next })
+}
+
+/// Any worker that is not finished (queued, mining, held or submitting) blocks `start`.
+pub(crate) fn busy(statuses: &[MinerStatus]) -> bool {
+    statuses.iter().any(|s| *s != MinerStatus::Finished)
+}
+
+/// A premine needs exactly one live worker, and that one is submitting.
+pub(crate) fn can_premine(statuses: &[MinerStatus]) -> bool {
+    let mut live = statuses.iter().filter(|s| **s != MinerStatus::Finished);
+    live.next() == Some(&MinerStatus::Submitting) && live.next().is_none()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn state(current: (u32, u32), old: (u32, u32)) -> SessionState {
+        SessionState {
+            seed: "0xA".into(),
+            seed_next: "0xB".into(),
+            easy_complexity: current.0,
+            hard_complexity: current.1,
+            easy_complexity_old: old.0,
+            hard_complexity_old: old.1,
+            commit_data: None,
+            commit_interval: None,
+            taps_size: 0,
+            mbi_cur: None,
+            epoch_5m_start: 0,
+        }
+    }
+
+    #[test]
+    fn premine_on_next_seed_when_in_flight_and_complexity_stable() {
+        let st = state((10, 12), (10, 12));
+        assert_eq!(
+            resolve_premine(&st, "0xA"),
+            Ok(PremineTarget { seed: "0xB".into(), easy: 10, hard: 12, basis: PremineBasis::Next })
+        );
+    }
+
+    #[test]
+    fn premine_unsafe_when_complexity_changed_and_in_flight() {
+        let st = state((10, 13), (10, 12));
+        assert!(resolve_premine(&st, "0xA").unwrap_err().starts_with("complexity_unstable"));
+    }
+
+    #[test]
+    fn premine_on_current_seed_with_old_complexity_when_in_flight_finished() {
+        // the chain already rotated past the in-flight session's seed
+        let st = state((10, 13), (10, 12));
+        assert_eq!(
+            resolve_premine(&st, "0xZ"),
+            Ok(PremineTarget {
+                seed: "0xA".into(),
+                easy: 10,
+                hard: 12,
+                basis: PremineBasis::Current
+            })
+        );
+    }
+
+    #[test]
+    fn can_premine_only_with_a_single_submitting_worker() {
+        use MinerStatus::*;
+        assert!(!can_premine(&[]));
+        assert!(can_premine(&[Submitting]));
+        assert!(can_premine(&[Submitting, Finished]));
+        assert!(!can_premine(&[Submitting, Held]));
+        assert!(!can_premine(&[Submitting, Computing]));
+        assert!(!can_premine(&[Submitting, Queued]));
+        assert!(!can_premine(&[Computing]));
+        assert!(!can_premine(&[Held]));
+    }
+
+    #[test]
+    fn busy_includes_held() {
+        use MinerStatus::*;
+        assert!(busy(&[Held]));
+        assert!(busy(&[Submitting]));
+        assert!(busy(&[Queued]));
+        assert!(busy(&[Computing]));
+        assert!(!busy(&[Finished]));
+        assert!(!busy(&[]));
+    }
+}
