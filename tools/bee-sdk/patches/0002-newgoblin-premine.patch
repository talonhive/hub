+/// NewGoblin premine: seed and complexity of the session after the one in flight
+/// (`resolve_premine`), read without cancelling anything. `None` = do not mine: the state is
+/// unreadable (`complexity_unknown`, as `resolve_session`) or premining is unsafe
+/// (`premine_unsafe`).
+async fn resolve_premine_session(
+    worker: &MinerWorker,
+    callback: &js_sys::Function,
+) -> Option<(String, u32, u32, &'static str)> {
+    let state = match read_session_state_retry(&worker.contract).await {
+        Ok(state) => state,
+        Err(message) => {
+            send_callback(
+                callback,
+                CallbackData::data(
+                    "complexity_unknown",
+                    Some(json!({"worker_id": worker.id, "message": message})),
+                ),
+            );
+            return None;
+        }
+    };
+    match resolve_premine(&state, &worker.in_flight_seed) {
+        Ok(target) => {
+            send_callback(
+                callback,
+                CallbackData::data(
+                    "premine_resolved",
+                    Some(json!({
+                        "worker_id": worker.id,
+                        "seed": target.seed,
+                        "basis": target.basis.name(),
+                        "complexity": [target.easy, target.hard],
+                    })),
+                ),
+            );
+            let old = (state.easy_complexity_old, state.hard_complexity_old);
+            let source = if (target.easy, target.hard) == old { "old" } else { "current" };
+            Some((target.seed, target.easy, target.hard, source))
+        }
+        Err(reason) => {
+            send_callback(
+                callback,
+                CallbackData::data(
+                    "premine_unsafe",
+                    Some(json!({"worker_id": worker.id, "reason": reason})),
+                ),
+            );
+            None
+        }
+    }
+}
+
+/// NewGoblin premine: `Held` until `release_submit()` was called and no other worker is left
+/// (the in-flight session was removed), checked every second. `false` = it ended quietly
+/// (discarded or the Miner was freed), nothing sent.
+async fn hold_premine(
+    worker: &MinerWorker,
+    workers_ref: &Rc<RefCell<Vec<MinerWorker>>>,
+    callback: &js_sys::Function,
+    taps: usize,
+) -> bool {
+    update_worker_status(worker.id, workers_ref, MinerStatus::Held);
+    send_callback(
+        callback,
+        CallbackData::data(
+            "status_updated",
+            Some(json!({"worker_id": worker.id, "status": MinerStatus::Held.to_string()})),
+        ),
+    );
+    send_callback(
+        callback,
+        CallbackData::data("premine_ready", Some(json!({"worker_id": worker.id, "taps": taps}))),
+    );
+    let held_at = now_ms();
+    while !worker.premine_ended() {
+        let alone = workers_ref
+            .borrow()
+            .iter()
+            .all(|w| w.id == worker.id || w.status == MinerStatus::Finished);
+        if worker.premine_release.get() && alone {
+            send_callback(
+                callback,
+                CallbackData::data(
+                    "premine_released",
+                    Some(json!({
+                        "worker_id": worker.id,
+                        "held_ms": now_ms().saturating_sub(held_at),
+                    })),
+                ),
+            );
+            // JS may discard it from that callback: it is still held, nothing sent.
+            if !worker.premine_ended() {
+                return true;
+            }
+            break;
+        }
+        gloo_timers::future::TimeoutFuture::new(1000).await;
+    }
+    shutdown_worker(worker, workers_ref, false, false, callback);
+    false
+}
+
 async fn commit_is(worker: &MinerWorker, data_hex: &str) -> Result<bool, String> {
     Ok(read_session_state(&worker.contract).await?.has_commit(data_hex))
 }
