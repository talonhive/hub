+/// NewGoblin premine: copies the resolved seed and complexity of `run`'s local worker into its
+/// shared entry.
+fn update_worker_session(worker: &MinerWorker, workers_ref: &Rc<RefCell<Vec<MinerWorker>>>) {
+    if let Some(w) = workers_ref.borrow_mut().iter_mut().find(|w| w.id == worker.id) {
+        w.seed = worker.seed.clone();
+        w.easy_complexity = worker.easy_complexity;
+        w.hard_complexity = worker.hard_complexity;
+    }
+}
+
 fn shutdown_worker(
     worker: &MinerWorker,
     workers_ref: &Rc<RefCell<Vec<MinerWorker>>>,
@@ -826,6 +881,108 @@ async fn resolve_session(
