+/// NewGoblin premine (patch 0003): `state` is the read the premine session's preflight is about
+/// to judge, taken while the session is still `Held`. While it still shows the in-flight
+/// session's commit on its seed, that session's end (accepted or cancelled) may not have reached
+/// this read yet, and the preflight would discard the session (`seed_changed`) though the chain
+/// is about to show its seed. Re-reads once a second, for up to `PREMINE_CHAIN_WAIT_MS`, until a
+/// read no longer shows it. A failed re-read keeps the last good state. A discarded session or a
+/// freed Miner (`premine_ended`) ends the wait: the caller then ends quietly, and nothing is
+/// emitted here. Otherwise emits `premine_chain_wait` if it waited at all. Returns the state the
+/// preflight runs on.
+async fn wait_for_in_flight_end(
+    worker: &MinerWorker,
+    callback: &js_sys::Function,
+    mut state: SessionState,
+) -> SessionState {
+    let started_at = now_ms();
+    let mut polled = false;
+    while awaiting_in_flight_end(&state, &worker.in_flight_seed)
+        && now_ms().saturating_sub(started_at) < PREMINE_CHAIN_WAIT_MS
+        && !worker.premine_ended()
+    {
+        gloo_timers::future::TimeoutFuture::new(PREMINE_CHAIN_POLL_MS).await;
+        polled = true;
+        if let Ok(fresh) = read_session_state(&worker.contract).await {
+            state = fresh;
+        }
+    }
+    if polled && !worker.premine_ended() {
+        send_diag(
+            callback,
+            worker.id,
+            "premine_chain_wait",
+            json!({
+                "waited_ms": now_ms().saturating_sub(started_at),
+                "settled": !awaiting_in_flight_end(&state, &worker.in_flight_seed),
+            }),
+        );
+    }
+    state
+}
+
 async fn commit_is(worker: &MinerWorker, data_hex: &str) -> Result<bool, String> {
     Ok(read_session_state(&worker.contract).await?.has_commit(data_hex))
