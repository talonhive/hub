+/// NewGoblin patch 0003: how long a premine session waits, before its preflight, for the chain to
+/// stop showing the in-flight session's commit.
+pub(crate) const PREMINE_CHAIN_WAIT_MS: u64 = 15_000;
+/// NewGoblin patch 0003: pause between the re-reads of that wait.
+pub(crate) const PREMINE_CHAIN_POLL_MS: u32 = 1_000;
+
+/// NewGoblin patch 0003: the chain still shows the in-flight session as pending: `_seed` is still
+/// its seed and its commit is set. A read taken a moment before that session ends (accept or
+/// cancel, both do `_seed = _seedNext`) looks like this, and the premine session's preflight
+/// would discard it (`seed_changed`). With no commit set the root never landed, so there is no
+/// end to wait for; an empty `in_flight_seed` is a normal session.
+pub(crate) fn awaiting_in_flight_end(state: &SessionState, in_flight_seed: &str) -> bool {
+    !in_flight_seed.is_empty() && state.seed == in_flight_seed && state.commit_data.is_some()
+}
