+/// NewGoblin W7: `cancelCommitData`, delivered until `_commitData` is gone.
+/// Not bounded by the epoch: a stale commit blocks every later session.
+pub(crate) async fn cancel_stale_commit(
+    worker: &MinerWorker,
+    reason: &str,
+    own: Option<&str>,
+    callback: &js_sys::Function,
+) -> bool {
+    if worker.dropped.get() {
+        return false;
+    }
+    let policy = worker.policy.get();
+    let params = ParamsOfCancelSession { app_id: worker.app_id.clone() };
+    let signer = Signer::Keys { keys: worker.keys.clone() };
+    match read_session_state_retry(&worker.contract).await {
+        // Nothing (of ours) to cancel, e.g. accepted after all: send nothing.
+        Ok(state) if !may_cancel(&state, own) => {
+            return own.is_some() || state.commit_data.is_none()
+        }
+        Ok(_) => {}
+        // Ownership cannot be checked: never cancel blind after a session of ours.
+        Err(_) if own.is_some() => return false,
+        Err(_) => {}
+    }
+    let result = match prepare(worker, "cancelCommitData", json!(params), signer).await {
+        Ok(msg) => delivery::deliver(
+            worker.send_contract.context().clone(),
+            &msg,
+            "cancel",
+            now_ms() + policy.root_deadline_ms,
+            0,
+            policy,
+            || async { Ok(read_session_state(&worker.contract).await?.commit_data.is_none()) },
+            &|action, data| send_diag(callback, worker.id, action, data),
+            &|| worker.dropped.get(),
+        )
+        .await
+        .map(|_| msg.message_id().to_string())
+        .map_err(|e| e.message),
+        Err(e) => Err(e),
+    };
+    let ok = result.is_ok();
+    send_callback(
+        callback,
+        CallbackData::data(
+            "stale_commit_cancelled",
+            Some(json!({
+                "worker_id": worker.id,
+                "reason": reason,
+                "ok": ok,
+                "message_id": result.as_ref().ok(),
+                "error": result.as_ref().err(),
+            })),
+        ),
+    );
+    ok
 }
 
