+//! NewGoblin patch, design doc `docs/research/2026-10-31-bee-sdk-patch-design.md` §E.2.
+//!
+//! Delivery of one signed external message (`PreparedMessage`): the SAME BOC is
+//! resent until the node accepts it, the chain shows its effect (`confirm`), or
+//! the deadline passes. Resending the same BOC keeps the message id, so the
+//! node deduplicates it and the contract cannot run it twice; re-signing (what
+//! a plain retry of `send_message` does) would create a second message.
+
+use std::sync::Arc;
+
+use ackinacki_kit::contracts::delivery::PreparedMessage;
+use ackinacki_kit::tvm_client::error::ClientError;
+use ackinacki_kit::tvm_client::ClientContext;
+use futures::future::select;
+use futures::future::Either;
+use serde_json::json;
+use serde_json::Value;
+
+/// Lifetime (`expire` header) of every message the miner signs. The SDK default is 40 s.
+pub(crate) const MESSAGE_EXPIRATION_MS: u32 = 240_000;
+/// `query_timeout` of the sending context: the BM answers sends in 31–50 s.
+pub(crate) const SEND_QUERY_TIMEOUT_MS: u32 = 60_000;
+/// `query_timeout` of the reading context (event poll, account reads), as upstream.
+pub(crate) const READ_QUERY_TIMEOUT_MS: u32 = 10_000;
+/// Stop resending this long before the message expires.
+const EXPIRY_MARGIN_MS: u64 = 2_000;
+
+// tvm_client error codes (client/errors.rs, net/errors.rs, processing/errors.rs).
+const WEBSOCKET_CONNECT_ERROR: u32 = 6;
+const WEBSOCKET_RECEIVE_ERROR: u32 = 7;
+const WEBSOCKET_SEND_ERROR: u32 = 8;
+const HTTP_REQUEST_SEND_ERROR: u32 = 11; // network error, timeout, "Server responded with code 5xx/429"
+const HTTP_REQUEST_PARSE_ERROR: u32 = 12; // e.g. an HTML 502 page on the last transport attempt
+const MESSAGE_ALREADY_EXPIRED: u32 = 501;
+const MESSAGE_EXPIRED: u32 = 507;
+const WEBSOCKET_DISCONNECTED: u32 = 610;
+const GRAPHQL_WEBSOCKET_INIT_ERROR: u32 = 613;
+const GRAPHQL_CONNECTION_ERROR: u32 = 617;
+const ALL_ATTEMPTS_FAILED: u32 = 623;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) struct SubmitPolicy {
+    pub root_deadline_ms: u64,
+    pub proof_deadline_ms: u64,
+    pub retry_min_ms: u64,
+    pub retry_max_ms: u64,
+    /// One `send_once` call (the SDK's 3 transport attempts) is cut after this.
+    pub attempt_timeout_ms: u64,
+    /// Absolute (`Date.now()` scale); 0 = off.
+    pub epoch_deadline_ms: u64,
+}
+
+impl Default for SubmitPolicy {
+    fn default() -> Self {
+        Self {
+            root_deadline_ms: 210_000,
+            proof_deadline_ms: 240_000,
+            retry_min_ms: 1_000,
+            retry_max_ms: 30_000,
+            attempt_timeout_ms: SEND_QUERY_TIMEOUT_MS as u64 + 5_000,
+            epoch_deadline_ms: 0,
+        }
+    }
+}
+
+impl SubmitPolicy {
+    /// `set_submit_policy` values, clamped to sane ranges; keeps the epoch deadline.
+    pub fn with_limits(
+        self,
+        root_deadline_ms: u32,
+        proof_deadline_ms: u32,
+        retry_min_ms: u32,
+        retry_max_ms: u32,
+    ) -> Self {
+        let retry_min_ms = (retry_min_ms as u64).clamp(100, 60_000);
+        Self {
+            root_deadline_ms: (root_deadline_ms as u64).clamp(10_000, 600_000),
+            proof_deadline_ms: (proof_deadline_ms as u64).clamp(10_000, 600_000),
+            retry_min_ms,
+            retry_max_ms: (retry_max_ms as u64).clamp(retry_min_ms, 120_000),
+            ..self
+        }
+    }
+
+    /// `set_epoch_deadline` value: absolute ms, anything not finite or <= 0 turns it off.
+    pub fn with_epoch_deadline(self, epoch_deadline_ms: f64) -> Self {
+        let epoch_deadline_ms = if epoch_deadline_ms.is_finite() && epoch_deadline_ms > 0.0 {
+            epoch_deadline_ms as u64
+        } else {
+            0
+        };
+        Self { epoch_deadline_ms, ..self }
+    }
+}
+
+/// Outcome of one send attempt.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) enum Attempt {
+    Accepted,
+    /// The node already has this message id.
+    Duplicate,
+    /// The message may or may not have been taken (network, queue full, BP redirect…).
+    Ambiguous(String),
+    /// It ran and the compute phase failed: resending the same BOC cannot help.
+    ExecutedFailed(String),
+    Expired,
+    Fatal(String),
+}
+
+impl Attempt {
+    pub fn name(&self) -> &'static str {
+        match self {
+            Attempt::Accepted => "accepted",
+            Attempt::Duplicate => "duplicate",
+            Attempt::Ambiguous(_) => "ambiguous",
+            Attempt::ExecutedFailed(_) => "executed_failed",
+            Attempt::Expired => "expired",
+            Attempt::Fatal(_) => "fatal",
+        }
+    }
+}
+
+/// `node_code` is `data.node_error.extensions.code` (tvm_client net/errors.rs
+/// `send_message_server_error`), `code` the ClientError code.
+pub(crate) fn classify_parts(code: u32, node_code: Option<&str>, message: &str) -> Attempt {
+    match node_code {
+        Some("DUPLICATE_MESSAGE") => return Attempt::Duplicate,
+        Some(
+            c @ ("QUEUE_OVERFLOW" | "INTERNAL_ERROR" | "WRONG_PRODUCER" | "THREAD_MISMATCH"
+            | "TOKEN_EXPIRED"),
+        ) => return Attempt::Ambiguous(c.to_string()),
+        Some("TVM_ERROR") => return Attempt::ExecutedFailed(message.to_string()),
+        _ => {}
+    }
+    match code {
+        MESSAGE_ALREADY_EXPIRED | MESSAGE_EXPIRED => Attempt::Expired,
+        WEBSOCKET_CONNECT_ERROR
+        | WEBSOCKET_RECEIVE_ERROR
+        | WEBSOCKET_SEND_ERROR
+        | HTTP_REQUEST_SEND_ERROR
+        | HTTP_REQUEST_PARSE_ERROR
+        | WEBSOCKET_DISCONNECTED
+        | GRAPHQL_WEBSOCKET_INIT_ERROR
+        | GRAPHQL_CONNECTION_ERROR
+        | ALL_ATTEMPTS_FAILED => Attempt::Ambiguous(message.to_string()),
+        _ => Attempt::Fatal(message.to_string()),
+    }
+}
+
+/// A send the node answered with a result: it ran. `aborted` or a compute exit code other than
+/// 0/1 (TVM success codes) means it ran and failed, like a `TVM_ERROR`.
+pub(crate) fn classify_result(aborted: Option<bool>, exit_code: Option<i32>) -> Attempt {
+    match (aborted, exit_code) {
+        (Some(true), code) => Attempt::ExecutedFailed(format!("aborted (exit_code {code:?})")),
+        (_, Some(code)) if code != 0 && code != 1 => {
+            Attempt::ExecutedFailed(format!("exit_code {code}"))
+        }
+        _ => Attempt::Accepted,
+    }
+}
+
+pub(crate) fn node_code(e: &ClientError) -> Option<&str> {
+    e.data().pointer("/node_error/extensions/code").and_then(Value::as_str)
+}
+
+pub(crate) fn classify(e: &ClientError) -> Attempt {
+    classify_parts(e.code(), node_code(e), e.message())
+}
+
+/// `min(deadline, expires_at - 2 s, epoch deadline if set)`, all in ms.
+pub(crate) fn hard_deadline(
+    deadline_ms: u64,
+    expires_at_s: Option<u32>,
+    epoch_deadline_ms: u64,
+) -> u64 {
+    let mut d = deadline_ms;
+    if let Some(expires_at) = expires_at_s {
+        d = d.min((expires_at as u64 * 1000).saturating_sub(EXPIRY_MARGIN_MS));
+    }
+    if epoch_deadline_ms != 0 {
+        d = d.min(epoch_deadline_ms);
+    }
+    d
+}
+
+/// Pause before resend `k` (0-based): `min(retry_max, retry_min * 2^k)` plus 0–20 % jitter
+/// (`rand` in `[0, 1]`).
+pub(crate) fn backoff_ms(k: u32, policy: &SubmitPolicy, rand: f64) -> u64 {
+    let factor = 1u64.checked_shl(k).unwrap_or(u64::MAX);
+    let base = policy.retry_min_ms.saturating_mul(factor).min(policy.retry_max_ms);
+    let jitter = (base as f64 * 0.2 * rand.clamp(0.0, 1.0)).round() as u64;
+    base + jitter
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum DeliveryOk {
+    /// The node accepted the message.
+    Sent,
+    /// `confirm` saw its effect on chain (late landing, duplicate…).
+    ConfirmedOnChain,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) struct DeliveryErr {
+    /// `executed_failed` | `expired` | `fatal` | `deadline` | `not_sent` (deadline already past) |
+    /// `dropped` (the Miner was freed)
+    pub kind: &'static str,
+    pub message: String,
+}
+
+pub(crate) fn now_ms() -> u64 {
+    js_sys::Date::now() as u64
+}
+
+/// Sends `msg` until it is accepted, confirmed on chain or `hard_deadline` passes.
+/// Every attempt is reported as `on_event("send_attempt", {...})`.
+pub(crate) async fn deliver<C, CF>(
+    client: Arc<ClientContext>,
+    msg: &PreparedMessage,
+    label: &str,
+    deadline_ms: u64,
+    epoch_deadline_ms: u64,
+    policy: SubmitPolicy,
+    confirm: C,
+    on_event: &dyn Fn(&str, Value),
+    dropped: &dyn Fn() -> bool,
+) -> Result<DeliveryOk, DeliveryErr>
+where
+    C: Fn() -> CF,
+    CF: Future<Output = Result<bool, String>>,
+{
+    let hard = hard_deadline(deadline_ms, msg.expires_at(), epoch_deadline_ms);
+    let mut attempt: u32 = 0;
+    let mut last_error = String::from("deadline reached before the first attempt");
+
+    while now_ms() < hard {
+        // The Miner was freed (its workers keep running): never send for it again.
+        if dropped() {
+            return Err(DeliveryErr { kind: "dropped", message: "miner dropped".into() });
+        }
+        attempt += 1;
+        let budget = policy.attempt_timeout_ms.min(hard.saturating_sub(now_ms())).max(1);
+        let send = Box::pin(msg.send_once(client.clone()));
+        let timer = Box::pin(gloo_timers::future::TimeoutFuture::new(budget as u32));
+        let (outcome, code, node) = match select(send, timer).await {
+            Either::Left((Ok(r), _)) => (classify_result(r.aborted, r.exit_code), None, None),
+            Either::Left((Err(e), _)) => {
+                (classify(&e), Some(e.code()), node_code(&e).map(str::to_string))
+            }
+            Either::Right(_) => (Attempt::Ambiguous("attempt timeout".to_string()), None, None),
+        };
+        let detail = match &outcome {
+            Attempt::Ambiguous(m) | Attempt::ExecutedFailed(m) | Attempt::Fatal(m) => m.clone(),
+            _ => String::new(),
+        };
+        on_event(
+            "send_attempt",
+            json!({
+                "kind": label,
+                "attempt": attempt,
+                "outcome": outcome.name(),
+                "code": code,
+                "node_code": node,
+                "message_id": msg.message_id(),
+                "error": if detail.is_empty() { None } else { Some(detail.clone()) },
+            }),
+        );
+
+        match outcome {
+            Attempt::Accepted => return Ok(DeliveryOk::Sent),
+            Attempt::Expired => {
+                if let Ok(true) = confirm().await {
+                    return Ok(DeliveryOk::ConfirmedOnChain);
+                }
+                return Err(DeliveryErr { kind: "expired", message: "message expired".into() });
+            }
+            Attempt::Fatal(m) => return Err(DeliveryErr { kind: "fatal", message: m }),
+            Attempt::Duplicate | Attempt::Ambiguous(_) | Attempt::ExecutedFailed(_) => {
+                if let Ok(true) = confirm().await {
+                    return Ok(DeliveryOk::ConfirmedOnChain);
+                }
+                if let Attempt::ExecutedFailed(m) = outcome {
+                    return Err(DeliveryErr { kind: "executed_failed", message: m });
+                }
+                last_error = if detail.is_empty() { outcome.name().to_string() } else { detail };
+            }
+        }
+
+        let pause = backoff_ms(attempt - 1, &policy, js_sys::Math::random());
+        let left = hard.saturating_sub(now_ms());
+        if pause >= left {
+            break;
+        }
+        gloo_timers::future::TimeoutFuture::new(pause as u32).await;
+    }
+
+    // Last look before giving up: it may have landed during the final attempt.
+    if let Ok(true) = confirm().await {
+        return Ok(DeliveryOk::ConfirmedOnChain);
+    }
+    let kind = if attempt == 0 { "not_sent" } else { "deadline" };
+    Err(DeliveryErr { kind, message: last_error })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn err_with_node_code(code: u32, node: &str) -> ClientError {
+        let mut e = ClientError::with_code_message(code, format!("node said {node}"));
+        e.data_mut()["node_error"]["extensions"]["code"] = Value::String(node.to_string());
+        e
+    }
+
+    #[test]
+    fn classify_node_codes() {
+        assert_eq!(classify(&err_with_node_code(621, "DUPLICATE_MESSAGE")), Attempt::Duplicate);
+        for c in [
+            "QUEUE_OVERFLOW",
+            "INTERNAL_ERROR",
+            "WRONG_PRODUCER",
+            "THREAD_MISMATCH",
+            "TOKEN_EXPIRED",
+        ] {
+            assert_eq!(
+                classify(&err_with_node_code(621, c)),
+                Attempt::Ambiguous(c.to_string()),
+                "{c}"
+            );
+        }
+        assert!(matches!(
+            classify(&err_with_node_code(621, "TVM_ERROR")),
+            Attempt::ExecutedFailed(_)
+        ));
+        // An unknown node code falls through to the ClientError code: 621 is not retryable.
+        assert!(matches!(classify(&err_with_node_code(621, "SOMETHING_NEW")), Attempt::Fatal(_)));
+    }
+
+    #[test]
+    fn classify_client_codes() {
+        let c = |code: u32, msg: &str| classify(&ClientError::with_code_message(code, msg.into()));
+        // 3 x query_timeout in query_http: "fetch operation timeout", code 11 (§A.1)
+        assert!(matches!(c(11, "fetch operation timeout"), Attempt::Ambiguous(_)));
+        assert!(matches!(c(11, "Server responded with status 502"), Attempt::Ambiguous(_)));
+        assert!(matches!(c(11, "Server responded with code 429: busy"), Attempt::Ambiguous(_)));
+        assert!(matches!(c(12, "Body is not a valid JSON"), Attempt::Ambiguous(_)));
+        assert!(matches!(c(623, "All attempts failed."), Attempt::Ambiguous(_)));
+        for code in [6, 7, 8, 610, 613, 617] {
+            assert!(matches!(c(code, "net"), Attempt::Ambiguous(_)), "{code}");
+        }
+        assert_eq!(c(501, "Message expired"), Attempt::Expired);
+        assert_eq!(c(507, "Message expired"), Attempt::Expired);
+        assert!(matches!(c(23, "Invalid params"), Attempt::Fatal(_)));
+        assert!(matches!(c(518, "dapp_id required"), Attempt::Fatal(_)));
+        assert!(matches!(c(621, "send failed without node code"), Attempt::Fatal(_)));
+    }
+
+    #[test]
+    fn node_code_wins_over_client_code() {
+        // A TVM_ERROR carried by an "Ambiguous" client code is still an executed failure.
+        assert!(matches!(classify_parts(11, Some("TVM_ERROR"), "x"), Attempt::ExecutedFailed(_)));
+        assert_eq!(classify_parts(501, Some("DUPLICATE_MESSAGE"), "x"), Attempt::Duplicate);
+    }
+
+    #[test]
+    fn a_node_result_that_aborted_is_an_executed_failure() {
+        assert_eq!(classify_result(None, None), Attempt::Accepted);
+        assert_eq!(classify_result(Some(false), Some(0)), Attempt::Accepted);
+        assert_eq!(classify_result(Some(false), Some(1)), Attempt::Accepted);
+        assert!(matches!(classify_result(Some(true), Some(0)), Attempt::ExecutedFailed(_)));
+        assert!(matches!(classify_result(Some(true), None), Attempt::ExecutedFailed(_)));
+        assert!(matches!(classify_result(None, Some(102)), Attempt::ExecutedFailed(_)));
+        assert!(matches!(classify_result(Some(false), Some(-14)), Attempt::ExecutedFailed(_)));
+    }
+
+    #[test]
+    fn hard_deadline_takes_the_earliest_bound() {
+        let now = 1_800_000_000_000u64;
+        let expires = ((now + 240_000) / 1000) as u32;
+        // root: 210 s < expiry - 2 s
+        assert_eq!(hard_deadline(now + 210_000, Some(expires), 0), now + 210_000);
+        // proof: 240 s is cut by expiry - 2 s
+        assert_eq!(hard_deadline(now + 240_000, Some(expires), 0), now + 238_000);
+        // epoch end first
+        assert_eq!(hard_deadline(now + 210_000, Some(expires), now + 60_000), now + 60_000);
+        // epoch end after the others: ignored
+        assert_eq!(hard_deadline(now + 210_000, Some(expires), now + 900_000), now + 210_000);
+        // no expire header: deadline only
+        assert_eq!(hard_deadline(now + 5_000, None, 0), now + 5_000);
+        // already expired message: in the past (no attempt is made)
+        assert_eq!(hard_deadline(now, Some(1), 0), 0);
+    }
+
+    #[test]
+    fn backoff_doubles_up_to_max_and_jitter_is_bounded() {
+        let p = SubmitPolicy::default();
+        assert_eq!(backoff_ms(0, &p, 0.0), 1_000);
+        assert_eq!(backoff_ms(1, &p, 0.0), 2_000);
+        assert_eq!(backoff_ms(4, &p, 0.0), 16_000);
+        assert_eq!(backoff_ms(5, &p, 0.0), 30_000);
+        assert_eq!(backoff_ms(200, &p, 0.0), 30_000); // no shift overflow
+        for k in 0..12 {
+            let base = backoff_ms(k, &p, 0.0);
+            for r in [0.0, 0.25, 0.5, 0.999, 1.0, 7.0, -3.0] {
+                let v = backoff_ms(k, &p, r);
+                assert!(v >= base && v <= base + base / 5, "k={k} r={r} v={v}");
+            }
+        }
+        assert_eq!(backoff_ms(5, &p, 1.0), 36_000);
+    }
+
+    #[test]
+    fn policy_is_clamped_and_keeps_epoch_deadline() {
+        let p = SubmitPolicy::default().with_epoch_deadline(1_800_000_000_000.0);
+        let q = p.with_limits(0, u32::MAX, 0, 1);
+        assert_eq!(q.root_deadline_ms, 10_000);
+        assert_eq!(q.proof_deadline_ms, 600_000);
+        assert_eq!(q.retry_min_ms, 100);
+        assert_eq!(q.retry_max_ms, 100); // never below retry_min
+        assert_eq!(q.epoch_deadline_ms, 1_800_000_000_000);
+        let d = SubmitPolicy::default().with_limits(210_000, 240_000, 1_000, 30_000);
+        assert_eq!(d, SubmitPolicy::default());
+        assert_eq!(p.with_epoch_deadline(0.0).epoch_deadline_ms, 0);
+        assert_eq!(p.with_epoch_deadline(f64::NAN).epoch_deadline_ms, 0);
+        assert_eq!(p.with_epoch_deadline(-5.0).epoch_deadline_ms, 0);
+    }
+}
