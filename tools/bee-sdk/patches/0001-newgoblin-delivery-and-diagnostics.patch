+/// Moves a pending accepted/rejected command out of the channel into `slot`.
+fn take_result(
+    receiver: &mut UnboundedReceiver<MinerCommand>,
+    slot: &RefCell<Option<MinerCommand>>,
+) -> bool {
+    if slot.borrow().is_some() {
+        return true;
+    }
+    while let Ok(cmd) = receiver.try_recv() {
+        if matches!(
+            cmd,
+            MinerCommand::ProcessSessionAccepted { .. }
+                | MinerCommand::ProcessSessionRejected { .. }
+        ) {
+            *slot.borrow_mut() = Some(cmd);
+            return true;
+        }
+    }
+    false
